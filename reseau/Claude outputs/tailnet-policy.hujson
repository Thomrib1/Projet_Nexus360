// Politique d'accès du tailnet commun Nexus360 (rôle Réseau).
// Aucune adresse e-mail : les propriétaires de tags sont des groupes automatiques.
{
	"tagOwners": {
		"tag:gw": ["autogroup:admin"],
	},

	"hosts": {
		"site1":     "10.36.11.0/24",
		"site2":     "10.36.12.0/24",
		"site3":     "10.36.13.0/24",
		"site4":     "10.36.14.0/24",
		"site5":     "10.36.15.0/24",
		"dc01":      "10.36.11.10/32",
		"dc02":      "10.36.12.11/32",
		"bastion":   "10.36.13.22/32",
		"lab":       "10.36.0.0/16",
	},

	// Routes de site annoncées par les passerelles : approuvées automatiquement.
	"autoApprovers": {
		"routes": {
			"10.36.11.0/24": ["tag:gw"],
			"10.36.12.0/24": ["tag:gw"],
			"10.36.13.0/24": ["tag:gw"],
			"10.36.14.0/24": ["tag:gw"],
			"10.36.15.0/24": ["tag:gw"],
		},
	},

	"acls": [
		// Les passerelles se joignent entre elles.
		{"action": "accept", "src": ["tag:gw"], "dst": ["tag:gw:*"]},

		// Trafic entre sites : DNS 53, DHCP 67 (relais), Kerberos 88, NTP 123, RPC 135,
		// LDAP 389, SMB 445, kpasswd 464, LDAPS 636, catalogue global 3268,
		// WinRM 5985, ADWS 9389 et ports RPC dynamiques 49152-65535.
		{
			"action": "accept",
			"src":    ["lab"],
			"dst":    ["lab:53,67,88,123,135,389,445,464,636,3268,5985,9389,49152-65535"],
		},
		// ICMP (ping, PMTUD) entre sites.
		{"action": "accept", "proto": "icmp", "src": ["lab"], "dst": ["lab:*"]},
	],

	"tests": [
		// DC02 doit joindre DC01 pour la promotion.
		{"src": "10.36.12.11", "accept": ["10.36.11.10:53", "10.36.11.10:88", "10.36.11.10:389", "10.36.11.10:445", "10.36.11.10:464", "10.36.11.10:135", "10.36.11.10:9389", "10.36.11.10:5985"]},
		// Un poste du site 4 joint les DC.
		{"src": "10.36.14.101", "accept": ["10.36.11.10:53", "10.36.12.11:445"]},
		// Pas d'accès à Internet par ce chemin, ni à un port non prévu.
		{"src": "10.36.14.101", "deny": ["8.8.8.8:53", "10.36.11.10:3389"]},
	],
}
