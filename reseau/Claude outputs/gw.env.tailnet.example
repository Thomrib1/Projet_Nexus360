# Passerelle sans backbone VMware (PC distant) : sites relies par le tailnet commun.
# Machine a 2 cartes : WAN (NAT) et LAN du site. Verifier les noms avec : ip -br a
BACKBONE=tailnet
WAN_IF=ens160
LAN_IF=ens192
BB_IF=tailscale0
BB_MTU=1280
ADMIN_USER=benor
ALLOW_WAN_SSH=0
WAN_ADMIN_NET=0.0.0.0/32
DHCP_RELAY_SITES=""
DHCP_SERVERS=""
TAILSCALE=1
