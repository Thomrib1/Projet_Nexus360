# shellcheck shell=bash
# Adresses utilisées par les scripts d'exploitation (check-infra.sh, test-alertes.sh).
# Source unique : doit rester identique à ansible/inventory/hosts.ini et au plan d'adressage du DAT.
# Répartition par rôle : 3e octet = numéro du site = numéro du rôle qui héberge la VM.
DOMAIN=ad.nexus360.test

# PC rôle 1 — site 1
GW1=10.36.11.1;  DC1=10.36.11.10
# PC rôle 2 — site 2 
GW2=10.36.12.1; FS=10.36.12.12; MGT=10.36.12.13
# PC rôle 3 — site 3
GW3=10.36.13.1;  WEB=10.36.13.21; OPS=10.36.13.22; APP=10.36.13.24
# PC rôle 4 — site 4  (DC02 administré par le rôle 1, hébergé ici)
GW4=10.36.14.1;  DC2=10.36.12.11;  MON=10.36.14.23
# PC rôle 5 — site 5
GW5=10.36.15.1;  CLIW1=10.36.15.101; CLILNX=10.36.15.102

# shellcheck disable=SC2034  # variables lues par les scripts qui « sourcent » ce fichier
GATEWAYS="$GW1 $GW2 $GW3 $GW4 $GW5"
