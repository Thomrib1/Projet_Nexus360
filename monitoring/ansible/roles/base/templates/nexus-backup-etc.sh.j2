#!/usr/bin/env bash
# {{ ansible_managed }}
# Sauvegarde de /etc de {{ inventory_hostname }} vers LNX-OPS01.
# L'archive conserve droits, ACL, attributs étendus et contextes SELinux.
# Côté OPS01, la clé SSH est liée à une commande forcée : on ne peut que déposer l'archive.
# Le code retour est publié pour Prometheus (alerte SauvegardeEnEchec).
set -uo pipefail
METRIC="{{ node_exporter_textfile_dir }}/nexus_backup_client.prom"

publier() {  # $1 = code retour
  local tmp
  tmp="$(mktemp "${METRIC}.XXXX")"
  {
    echo '# HELP nexus_backup_last_status Code retour du dernier envoi de sauvegarde (0 = OK).'
    echo '# TYPE nexus_backup_last_status gauge'
    echo "nexus_backup_last_status{type=\"etc\",source=\"{{ inventory_hostname }}\"} $1"
  } > "$tmp"
  chmod 0644 "$tmp" && mv "$tmp" "$METRIC"
}

{% if inventory_hostname in groups['ops'] %}
tar --acls --xattrs --selinux -czf - -C / etc \
  | sudo -u nexus-backup /usr/local/sbin/nexus-backup-receive etc {{ inventory_hostname }}
{% else %}
tar --acls --xattrs --selinux -czf - -C / etc \
  | ssh -i /root/.ssh/nexus_backup_ed25519 \
        -o BatchMode=yes -o ConnectTimeout=20 -o StrictHostKeyChecking=accept-new \
        nexus-backup@{{ ops_server_ip }}
{% endif %}
rc=$?
publier "$rc"
if [[ $rc -eq 0 ]]; then
  logger -t nexus-backup "sauvegarde /etc de {{ inventory_hostname }} envoyée vers LNX-OPS01"
else
  logger -p user.err -t nexus-backup "ÉCHEC sauvegarde /etc de {{ inventory_hostname }} (code $rc)"
fi
exit "$rc"
