# {{ ansible_managed }}
modules:
  http_2xx:
    prober: http
    timeout: 5s
    http:
      preferred_ip_protocol: ip4
      valid_status_codes: [200]
      # La page doit contenir l'identifiant de version (exigence A3) : sinon la sonde échoue
      fail_if_body_not_matches_regexp: ["[0-9a-f]{7,40}"]

  tcp_connect:
    prober: tcp
    timeout: 5s
    tcp:
      preferred_ip_protocol: ip4

  dns_ad:
    prober: dns
    timeout: 5s
    dns:
      preferred_ip_protocol: ip4
      transport_protocol: udp
      query_name: "intranet.{{ nexus_domain }}"
      query_type: A
      valid_rcodes: [NOERROR]

  icmp:
    prober: icmp
    timeout: 5s
