# {{ ansible_managed }}
[server]
http_addr = 0.0.0.0
http_port = 3000
domain = lnx-mon01.{{ nexus_domain }}

[security]
# Appliqué à la création de la base (1er démarrage). Pour changer ensuite :
#   grafana cli admin reset-admin-password '<nouveau>'
admin_user = admin
admin_password = {{ grafana_admin_password }}
disable_gravatar = true
cookie_samesite = strict

[users]
allow_sign_up = false

[auth.anonymous]
enabled = false

[analytics]
reporting_enabled = false
check_for_updates = false

[dashboards]
default_home_dashboard_path = /var/lib/grafana/dashboards/nexus360-etat-du-site.json

[log]
mode = console file
level = info
